CALCCAD 1
FORMAT 4 1000000 0.001 0
H 40 24 0 Växelströmskrets: två grenar parallellt
M 40 70 R_1:=6*ohm
M 240 70 X_L:=8j*ohm
M 40 110 R_2:=4*ohm
M 240 110 X_C:=-4j*ohm
M 40 150 V_T:=100*V
M 40 200 Z_1:=R_1+X_L=
M 40 240 Z_2:=R_2+X_C=
M 40 290 Z_T:={frac:Z_1*Z_2;Z_1+Z_2}=
M 40 350 I_T:={frac:V_T;Z_T}=
M 360 350 {abs:I_T}=
M 40 400 P:=Re(V_T*I_T)=kW
H 40 450 0 Funktioner, intervall och diagram
M 40 490 f(x):=x*sin(x)
M 40 530 t:=0,0.1..10
M 40 570 x:=2
M 160 570 {deriv:x;f(x)}=
M 40 615 {frac:1;2}+{sqrt:16}+{pow:2;10}=
M 40 660 {int:0;pi;f(x);x}=
M 40 720 A:={mat2x2:2;1;1;3}
M 200 720 eigenvals(A)=
M 40 790 {sum:k;1;10;{frac:1;{pow:k;2}}}=
P 410 575 280 220 * * * * t	f(t),{pow:t;0.5}*cos(t)
H 40 880 0 Program och symbolik
M 40 930 S(n):={prog3:s<-0;{for:k;1..n;s<-s+{frac:1;{pow:k;2}}};s}
M 400 930 S(1000)=
M 400 990 {deriv:x;{pow:x;2}*sin(x)}->
M 40 1080 expand({pow:(a+1);3})->
M 400 1080 {sqrt:72}+{frac:1;3}+{frac:1;6}->
